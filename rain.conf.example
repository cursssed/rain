# rain configuration


# =============================================================================
# Colors
# =============================================================================

# Palette mode.
#   auto    Generate a gradient from color_base.
#   manual  Use the explicit colors list below (default).
color_mode = manual

# Base color for auto mode.
# Format: #rrggbb
# color_base = #ffffff

# Manual palette. Setting this implicitly enables color_mode = manual.
# Must contain exactly speed_max entries (default: 5), brightest first.
# Too few entries fall back to auto mode; extra entries are ignored.
# Format: #rrggbb, #rrggbb, ...
colors = #ffffff, #949494, #686868, #464646, #393838

# Color backend.
#   false  Use init_color for exact RGB colors (default).
#          Works in ghostty, kitty, wezterm, xterm, alacritty.
#   true   Quantize to the built-in xterm-256 palette.
#          Use this when the terminal reports color-changing support but
#          ignores custom RGB values (konsole, some SSH/tmux setups).
use_xterm256 = false


# =============================================================================
# Timing
# =============================================================================

# Delay between frames, in milliseconds. Lower is faster.
frame_delay_ms = 40


# =============================================================================
# Density and speed
# =============================================================================

# Horizontal drop density: drops per terminal column.
density = 0.5

# Drop speed range, in rows per frame.
# speed_min must be <= speed_max.
# Drop shape: speed < 3 -> | speed >= 3 -> :
speed_min = 1
speed_max = 5


# =============================================================================
# Input
# =============================================================================

# Quit key. Must be a single character.
quit_key = q
